{
  "name": "@nutrigo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode playground --outDir dist-playground",
    "preview": "vite preview",
    "tokens": "node scripts/build-tokens.ts",
    "typecheck": "tsc -p .",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project desktop --grep @smoke"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
