{
  "$description": "NutriGo design tokens. Source of truth for apps/web/src/design-system/tokens.css (generated in Sprint 0). 'source' = defined in design/source/nutrigo.css :root. 'derived' = hard-coded in the Claude Design export, promoted to a token so components never use raw values. 'proposed' = added by engineering, pending owner validation.",
  "$meta": {
    "source": "design/source/nutrigo.css + *.dc.html (Claude Design export, 2026-09-23)",
    "themes": ["light"],
    "darkTheme": "none in the design (only a dark logo tile); out of scope for v1",
    "contrastStatus": "Known WCAG AA failures kept by owner decision (ADR-0008); fix by changing token values only"
  },
  "color": {
    "green": {
      "base":   { "$value": "#C2E66E", "$type": "color", "status": "source", "role": "Grains · success · primary CTA · calories" },
      "medium": { "$value": "#DFF9A2", "$type": "color", "status": "source" },
      "light":  { "$value": "#EDFFC4", "$type": "color", "status": "source" },
      "hover":  { "$value": "#B4DD57", "$type": "color", "status": "derived", "from": ".btn--primary-green:hover" },
      "on-light": { "$value": "#6F9018", "$type": "color", "status": "derived", "from": ".pill--green text" },
      "deep":   { "$value": "#5F7F12", "$type": "color", "status": "derived", "from": ".is-today .plan__dow" },
      "icon":   { "$value": "#8CB531", "$type": "color", "status": "derived", "from": ".icon-badge--green-light, article kicker" }
    },
    "yellow": {
      "base":   { "$value": "#FFCA65", "$type": "color", "status": "source", "role": "Veggies · steps · hydration · carbs" },
      "medium": { "$value": "#FFE6B5", "$type": "color", "status": "source" },
      "light":  { "$value": "#FFF1D6", "$type": "color", "status": "source" },
      "on-light": { "$value": "#B77A09", "$type": "color", "status": "derived", "from": ".pill--yellow text" },
      "icon":   { "$value": "#E0A02F", "$type": "color", "status": "derived", "from": ".icon-badge--yellow-light" }
    },
    "orange": {
      "base":   { "$value": "#FFA257", "$type": "color", "status": "source", "role": "Protein · weight · calories ring · promotional emphasis" },
      "medium": { "$value": "#FFE1C9", "$type": "color", "status": "source" },
      "light":  { "$value": "#FFF2E8", "$type": "color", "status": "source" },
      "hover":  { "$value": "#F8923E", "$type": "color", "status": "derived", "from": ".btn--primary-orange:hover" },
      "on-light": { "$value": "#D97426", "$type": "color", "status": "derived", "from": ".pill--orange text" },
      "link-hover": { "$value": "#D9812F", "$type": "color", "status": "derived", "from": "a:hover" },
      "soft":   { "$value": "#FFC79A", "$type": "color", "status": "derived", "from": "Grocery charts 'Fruits'/'Veggies' segment" }
    },
    "neutral": {
      "ink":     { "$value": "#1F2937", "$type": "color", "status": "source", "role": "Text primary" },
      "muted":   { "$value": "#6B7280", "$type": "color", "status": "source", "role": "Text secondary" },
      "faint":   { "$value": "#9CA3AF", "$type": "color", "status": "source", "role": "Placeholder, axis, decorative only (fails AA as text)" },
      "cream":   { "$value": "#FBF8F3", "$type": "color", "status": "source", "role": "Page background" },
      "surface": { "$value": "#FFFFFF", "$type": "color", "status": "source", "role": "Card surface" },
      "subtle":  { "$value": "#F8F6F1", "$type": "color", "status": "source", "role": "Subtle fill, list rows" },
      "line":    { "$value": "#F0EDE7", "$type": "color", "status": "source", "role": "Hairline" },
      "track":   { "$value": "#EEEEEE", "$type": "color", "status": "source", "role": "Progress track" },
      "grey-fill": { "$value": "#F3F3F1", "$type": "color", "status": "derived", "from": ".pill--grey, .icon-badge--grey" },
      "outline":   { "$value": "#E4E0D8", "$type": "color", "status": "derived", "from": ".pill--outline" },
      "chip-grey": { "$value": "#E2E1E4", "$type": "color", "status": "derived", "from": "Fats chip (Recipe Details)" },
      "media":   { "$value": "#EDEAE4", "$type": "color", "status": "derived", "from": "image placeholders" },
      "chart-other": { "$value": "#E9E7E2", "$type": "color", "status": "derived", "from": "'Others' segment" },
      "rail":    { "$value": "#FAF5F2", "$type": "color", "status": "derived", "from": "Recipe Details side panels" },
      "scrollbar": { "$value": "#E5E1D9", "$type": "color", "status": "derived" }
    }
  },
  "semantic": {
    "$description": "Canonical meaning → colour. Taken from the Design System page (stat chips) and confirmed by Healthy Menu + Recipe Details. Deviations in Dashboard/recipe-card pills are treated as design bugs.",
    "macro": {
      "kcal":    { "$value": "{color.green.base}" },
      "carbs":   { "$value": "{color.yellow.base}" },
      "protein": { "$value": "{color.orange.base}" },
      "fat":     { "$value": "{color.neutral.chip-grey}" }
    },
    "meal-slot": {
      "breakfast": { "$value": "{color.green.base}" },
      "lunch":     { "$value": "{color.yellow.base}" },
      "snack":     { "$value": "{color.neutral.grey-fill}" },
      "dinner":    { "$value": "{color.orange.base}" }
    },
    "food-category": {
      "grains":  { "$value": "{color.green.base}" },
      "veggies": { "$value": "{color.yellow.base}" },
      "protein": { "$value": "{color.orange.base}" },
      "fruits":  { "$value": "{color.orange.soft}" },
      "dairy":   { "$value": "{color.orange.medium}" },
      "others":  { "$value": "{color.neutral.chart-other}" }
    },
    "status": {
      "done":    { "$value": "{color.green.base}", "use": "meal eaten, item purchased" },
      "todo":    { "$value": "{color.yellow.base}", "use": "meal planned, not yet eaten" },
      "attention": { "$value": "{color.orange.base}", "use": "next meal / over target" }
    }
  },
  "radius": {
    "xs": { "$value": "6px", "status": "source" }, "sm": { "$value": "8px", "status": "source" },
    "md": { "$value": "12px", "status": "source" }, "lg": { "$value": "16px", "status": "source" },
    "xl": { "$value": "20px", "status": "source" }, "2xl": { "$value": "24px", "status": "source" },
    "pill": { "$value": "999px", "status": "source" }
  },
  "space": {
    "1": { "$value": "4px", "status": "source" }, "2": { "$value": "8px", "status": "source" },
    "3": { "$value": "12px", "status": "source" }, "4": { "$value": "16px", "status": "source" },
    "5": { "$value": "20px", "status": "source" }, "6": { "$value": "24px", "status": "source" },
    "8": { "$value": "32px", "status": "source" }, "10": { "$value": "40px", "status": "source" }
  },
  "shadow": {
    "outline": { "$value": "inset 0 0 0 1px {color.neutral.outline}", "status": "derived", "from": ".pill--outline box-shadow" },
    "soft": { "$value": "0 2px 16px rgba(31,41,55,.05)", "status": "source" },
    "card": { "$value": "0 1px 2px rgba(31,41,55,.04), 0 8px 24px rgba(31,41,55,.04)", "status": "source" },
    "phone": { "$value": "0 18px 50px rgba(31,41,55,.12)", "status": "derived" },
    "hairline": { "$value": "inset 0 0 0 1px {color.neutral.line}", "status": "derived", "from": ".btn--ghost box-shadow" }
  },
  "focus": {
    "$description": "Proposed. The export has no focus-visible style (issue D8).",
    "color":  { "$value": "{color.neutral.ink}", "status": "proposed" },
    "width":  { "$value": "2px", "status": "proposed" },
    "offset": { "$value": "2px", "status": "proposed" }
  },
  "opacity": {
    "disabled": { "$value": 0.5, "status": "proposed", "from": "design-system doc, disabled button" }
  },
  "font": {
    "family": { "sans": { "$value": "'Poppins', system-ui, -apple-system, sans-serif", "status": "source" } },
    "weight": {
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 },
      "bold": { "$value": 700 }, "extrabold": { "$value": 800 }
    },
    "tracking": {
      "tight": { "$value": "-0.02em", "status": "source", "from": ".sidebar__wordmark letter-spacing" }
    },
    "size": {
      "$description": "Proposed scale collapsing the ~20 ad-hoc sizes in the export. Mobile minimum 12px for text a user must read.",
      "micro":   { "$value": "11px",   "status": "proposed", "from": "10–11.5px labels (desktop only below 12px)" },
      "caption": { "$value": "12px",   "status": "proposed", "from": "11.5–12.5px" },
      "body":    { "$value": "14px",   "status": "source",   "from": "body font-size" },
      "title":   { "$value": "16px",   "status": "proposed", "from": ".card__title" },
      "figure-sm": { "$value": "20px", "status": "proposed", "from": "stat values 17–23px" },
      "figure":  { "$value": "28px",   "status": "proposed", "from": "key figures 24–34px" },
      "page":    { "$value": "26px",   "status": "proposed", "from": ".header__title" }
    }
  },
  "size": {
    "badge-sm":     { "$value": "28px", "status": "derived", "from": ".icon-badge" },
    "badge-lg":     { "$value": "44px", "status": "derived", "from": ".icon-badge--lg" },
    "touch-target": { "$value": "44px", "status": "source", "from": "Dashboard Mobile note: 'Hit targets stay at 44 px minimum'" },
    "sidebar":      { "$value": "252px", "status": "source" },
    "aside":        { "$value": "340px", "status": "source" },
    "control":      { "$value": "40px", "status": "source", "from": ".btn height" },
    "field":        { "$value": "42px", "status": "derived", "from": ".search-bar height" },
    "field-sm":     { "$value": "36px", "status": "derived", "from": ".search-bar--sm height" },
    "control-sm":   { "$value": "32px", "status": "source" },
    "pill":         { "$value": "26px", "status": "derived", "from": ".pill height" },
    "progress-bar": { "$value": "6px", "status": "derived", "from": ".progress-bar height" },
    "progress-bar-thin": { "$value": "5px", "status": "derived", "from": ".progress-bar--thin height" },
    "icon-xs":      { "$value": "12px", "status": "proposed", "from": "meal-check 11, star-rating 13, select-pill 13" },
    "icon-sm":      { "$value": "16px", "status": "proposed", "from": "icon-badge 15, search-bar 16, chevrons 14" },
    "icon-md":      { "$value": "18px", "status": "proposed", "from": "nav-link 18, header buttons 17" },
    "icon-lg":      { "$value": "20px", "status": "proposed", "from": "icon-badge--lg 20" },
    "logo-sm":      { "$value": "20px", "status": "source", "from": "Logo rules: minimum 20 px icon (mobile bar draws 22)" },
    "logo-md":      { "$value": "26px", "status": "source", "from": ".sidebar__brand svg" },
    "logo-lg":      { "$value": "52px", "status": "source", "from": "design-system header mark" }
  },
  "breakpoint": {
    "$description": "Proposed. The export only has 360px phones and 1600px desktops.",
    "mobile":  { "$value": "0px",    "status": "proposed", "layout": "1 column, bottom tab bar" },
    "tablet":  { "$value": "768px",  "status": "proposed", "layout": "1 column wider, tab bar" },
    "desktop": { "$value": "1200px", "status": "proposed", "layout": "sidebar + main (+ aside ≥ 1440px)" }
  },
  "motion": {
    "fast": { "$value": "150ms ease", "status": "derived", "from": "transition:.15s/.16s" }
  }
}
