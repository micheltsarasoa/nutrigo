{
  "name": "nutrigo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @nutrigo/web",
    "lint": "eslint . && stylelint \"apps/web/src/**/*.css\" --allow-empty-input && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @nutrigo/web",
    "test:e2e:smoke": "npm run test:e2e:smoke -w @nutrigo/web",
    "db:generate": "npm run db:generate -w @nutrigo/api",
    "db:migrate": "npm run db:migrate -w @nutrigo/api",
    "db:backup": "npm run db:backup -w @nutrigo/api",
    "docs:map": "node scripts/code-map.mjs",
    "design:export": "node scripts/design-system-export.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
